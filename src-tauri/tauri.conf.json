{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universe 3D",
  "version": "1.0.0",
  "identifier": "com.nurkan.universe3d",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "bash scripts/vendor-three.sh",
    "beforeBuildCommand": "bash scripts/vendor-three.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "3D Universe",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "3D Universe"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "3D universe app launcher",
    "longDescription": "Launch every desktop application as a glowing planet in an interactive 3D universe, with a live system monitor, category filters, command launcher and themes.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {}
}
