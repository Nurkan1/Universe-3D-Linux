# Dependencies
node_modules/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Vendored Three.js (regenerated by scripts/vendor-three.sh)
src/renderer/vendor/

# Logs
*.log
npm-debug.log*

# Core dumps
core.*

# OS / editor artifacts
.DS_Store
Thumbs.db

# Recordings (generated by the app, not source)
*.webm

# Local environment / secrets — never commit these
.env
.env.*
*.pem
*.key
secrets.json

# Local Claude Code settings (may contain machine-specific paths)
.claude/settings.local.json

# Editor / IDE
.vscode/
.idea/
*.swp
